@model IEnumerable<pet_project.Models.AdoptionApplication>
@{ ViewData["Title"]="Adoption Applications"; }<h1>Adoption Applications</h1><p><a asp-action="Create">Add an Application</a></p><table class="table table-striped"><thead><tr><th>Date</th><th>Status</th><th>Pet</th><th>Adopter</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ApplicationDate.ToShortDateString()</td><td>@x.Status</td><td>@x.Pet?.Name</td><td>@x.Adopter?.FullName</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> | <a asp-action="Details" asp-route-id="@x.Id">Details</a> | <a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td></tr>}</tbody></table>

