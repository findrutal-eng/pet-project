@model IEnumerable<pet_project.Models.Shelter>
@{ ViewData["Title"]="Shelters"; }<h1>Shelters</h1><p><a asp-action="Create">Add a Shelter</a></p><table class="table table-striped"><thead><tr><th>Name</th><th>City</th><th>Phone</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.City</td><td>@x.Phone</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> | <a asp-action="Details" asp-route-id="@x.Id">Details</a> | <a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td></tr>}</tbody></table>

