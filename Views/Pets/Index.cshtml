@model IEnumerable<pet_project.Models.Pet>
@{ ViewData["Title"]="Pets"; }<h1>Pets</h1><p><a asp-action="Create">Add a Pet</a></p><table class="table table-striped"><thead><tr><th>Name</th><th>Species</th><th>Age</th><th>Available</th><th>Shelter</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Species</td><td>@x.Age</td><td>@(x.IsAvailable?"Yes":"No")</td><td>@x.Shelter?.Name</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> | <a asp-action="Details" asp-route-id="@x.Id">Details</a> | <a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td></tr>}</tbody></table>

