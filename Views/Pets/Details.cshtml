@model pet_project.Models.Pet
@{ ViewData["Title"]="Pet Details"; }<h1>Pet Details</h1><hr/><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Species</dt><dd class="col-sm-9">@Model.Species</dd><dt class="col-sm-3">Age</dt><dd class="col-sm-9">@Model.Age</dd><dt class="col-sm-3">Available</dt><dd class="col-sm-9">@(Model.IsAvailable?"Yes":"No")</dd><dt class="col-sm-3">Shelter</dt><dd class="col-sm-9">@Model.Shelter?.Name</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back to List</a>

