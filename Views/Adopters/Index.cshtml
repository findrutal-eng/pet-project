@model IEnumerable<pet_project.Models.Adopter>
@{ ViewData["Title"]="Adopters"; }<h1>Adopters</h1><p><a asp-action="Create">Add an Adopter</a></p><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td>@x.Phone</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a> | <a asp-action="Details" asp-route-id="@x.Id">Details</a> | <a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td></tr>}</tbody></table>

